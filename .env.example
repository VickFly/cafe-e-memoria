# Copie para .env e preencha com os dados do seu projeto Supabase (Settings → API).
# Sem estas variáveis o app funciona em MODO LOCAL (respostas salvas só no aparelho) e avisa isso na tela.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha do painel no MODO LOCAL (apenas para testes; não é proteção real).
# No modo Supabase o painel usa login de usuário do Supabase Auth.
VITE_ADMIN_PASSCODE=cafe1911
